{
  "name": "api-ref-bundler",
  "version": "1.0.0",
  "description": "Bundle all external $ref in Json based API document into single document",
  "keywords": [
    "api",
    "asyncapi",
    "bundler",
    "dereference",
    "jsonschema",
    "openapi",
    "ref",
    "swagger"
  ],
  "license": "MIT",
  "author": "Damir Yusipov",
  "repository": {
    "type": "git",
    "url": "https://github.com/udamir/api-ref-bundler"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "typings": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "prepublish": "pnpm lint && pnpm build && pnpm test"
  },
  "dependencies": {
    "json-crawl": "1.2.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "js-yaml": "^4.1.1",
    "typescript": "^7.0.2",
    "vite-plus": "^1.7.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.21.0"
}
